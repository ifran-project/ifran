{# one device plugin pool per resource name, holding the indexes of its VFs on the fronthaul PF #}
{% set pools = {} %}
{% for vf in miscellaneous.fhi72_params[inventory_hostname].vfs %}
{% set _ = pools.setdefault(vf.resource_name, []).append(loop.index0 | string) %}
{% endfor %}
{
  "resourceList": [
{% for name, indexes in pools.items() %}
    {
      "resourcePrefix": "{{ miscellaneous.fhi72_params[inventory_hostname].resource_prefix }}",
      "resourceName": "{{ name }}",
      "deviceType": "netDevice",
      "selectors": {
        "drivers": ["vfio-pci"],
        "pfNames": ["{{ miscellaneous.fhi72_params[inventory_hostname].fronthaul_interface }}#{{ indexes | join(',') }}"]
      }
    }{{ "," if not loop.last else "" }}
{% endfor %}
  ]
}
