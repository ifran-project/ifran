{% endif %}

{% if component.advanced_config and component.advanced_config.channel_ul %}
[channel.ul]
{{ component.advanced_config.channel_ul }}
{% endif %}

{% if component.advanced_config and component.advanced_config.channel_ul_awgn %}
[channel.ul.awgn]
{{ component.advanced_config.channel_ul_awgn }}
{% endif %}

{% if component.advanced_config and component.advanced_config.channel_ul_fading %}
