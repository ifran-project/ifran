{% if component.advanced_config and component.advanced_config.phy %}
[phy]
{{ component.advanced_config.phy }}
{% endif %}

{% if component.advanced_config and component.advanced_config.phy_nr %}
[phy.nr]
{{ component.advanced_config.phy_nr }}
{% endif %}

{% if component.advanced_config and component.advanced_config.cfr %}
[cfr]
{{ component.advanced_config.cfr }}
{% endif %}

{% if component.advanced_config and component.advanced_config.sim %}
[sim]
{{ component.advanced_config.sim }}
{% endif %}

{% if component.advanced_config and component.advanced_config.general %}
[general]
{{ component.advanced_config.general }}
{% endif %}

{% endif %}