{% if component.plain_text_config %}
{{ component.plain_text_config }}
{%- else %}

[rf]
{% if component.advanced_config and component.advanced_config.rf %}
{{ component.advanced_config.rf }}
{% else %}
freq_offset = {{ component.advanced_config.freq_offset | default(0, true) }}
tx_gain = {{ component.config.ru.txGainDB }}
rx_gain = {{ component.config.ru.rxGainDB }}
srate = {{ component.advanced_config.srate | default("61.44e6", true) }}
nof_antennas = {{ component.config.ru.numberOfTxPorts }}
device_name = {{ component.derived_radio_config.device_driver }}
{% if component.advanced_config and component.advanced_config.device_args %}
device_args = {{ component.advanced_config.device_args }}
{% else %}
{% if component.config.ru.type == "usrp" %}
device_args = "addr={{ component.config.ru.ips[0] }},clock_source={{ component.config.ru.clockSource }},time_source={{ component.config.ru.timeSource }}"
{% elif component.config.ru.type == "simulated" %}
device_args = tx_port=tcp://{{ component.static_pod_ip }}:2001,rx_port=tcp://{{ component.config.gnbs[0].gnb_ip }}:2000,base_srate={{ component.advanced_config.srate | default("61.44e6", true) }}
{% endif %}
{% endif %}
{% endif %}

[rat.eutra]
{% if component.advanced_config and component.advanced_config.rat_eutra %}
{{ component.advanced_config.rat_eutra }}
{% else %}
dl_earfcn = 2850
nof_carriers = 0
{% endif %}

[rat.nr]
bands = {{ component.config.gnbs[0].config.radioConfiguration.nrBand }}
nof_carriers = {{ component.advanced_config.nof_carriers | default(1, true) }}
max_nof_prb = {{ component.derived_radio_config.nof_prb }}
nof_prb = {{ component.derived_radio_config.nof_prb }}

[pcap]
{% if component.advanced_config and component.advanced_config.pcap %}
{{ component.advanced_config.pcap }}
{% else %}
enable = none
mac_filename = /tmp/ue_mac.pcap
mac_nr_filename = /tmp/ue_mac_nr.pcap
nas_filename = /tmp/ue_nas.pcap
{% endif %}

[log]
{% if component.advanced_config and component.advanced_config.log %}
{{ component.advanced_config.log }}
{% else %}
all_level = info
phy_lib_level = none
all_hex_limit = 32
filename = /tmp/ue.log
file_max_size = -1
{% endif %}

[usim]
{% if component.advanced_config and component.advanced_config.usim %}
{{ component.advanced_config.usim }}
{% else %}
mode = soft
algo = milenage
opc  = "{{ component.config.authenticationData.opc }}"
{% if component.config.authenticationData.op %}
op   = "{{ component.config.authenticationData.op }}"
{% endif %}
k    = "{{ component.config.authenticationData.k }}"
imsi = "{{ component.config.supi }}"
imei = "{{ component.config.pei }}"
{% endif %}

[rrc]
{% if component.advanced_config and component.advanced_config.rrc %}
{{ component.advanced_config.rrc }}
{% else %}
release = 15
ue_category = 4
{% endif %}

[nas]
{% if component.advanced_config and component.advanced_config.nas %}
{{ component.advanced_config.nas }}
{% else %}
apn = "{{ component.config.subscriptions[component.config.pduSessions[0].subscriptionIndex].dnn.name }}"
apn_protocol = "{{ component.config.subscriptions[component.config.pduSessions[0].subscriptionIndex].dnn.pduSessionType }}"
{% endif %}

[slicing]
{% if component.advanced_config and component.advanced_config.slicing %}
{{ component.advanced_config.slicing }}
{% else %}
enable = true
nssai-sst = {{ component.config.subscriptions[component.config.pduSessions[0].subscriptionIndex].snssai.sst }}
{% if component.config.subscriptions[component.config.pduSessions[0].subscriptionIndex].snssai.sd %}
nssai-sd = {{ component.config.subscriptions[component.config.pduSessions[0].subscriptionIndex].snssai.sd | int(base=16) }}
{% endif %}
{% endif %}

[gw]
{% if component.advanced_config and component.advanced_config.gw %}
{{ component.advanced_config.gw }}
{% else %}
netns = ue
ip_devname = tun_srsue
ip_netmask = 255.255.255.0
{% endif %}

[gui]
{% if component.advanced_config and component.advanced_config.gui %}
{{ component.advanced_config.gui }}
{% else %}
enable = false
{% endif %}

{% if component.advanced_config and component.advanced_config.channel_dl %}
[channel.dl]
{{ component.advanced_config.channel_dl }}
{% endif %}

