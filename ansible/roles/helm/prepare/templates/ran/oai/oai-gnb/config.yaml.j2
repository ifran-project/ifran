{% if component.plain_text_config %}
{{ component.plain_text_config }}
{%- else %}
{# numeric advanced parameters: the default applies only when unset, as 0 is often a valid value #}
Active_gNBs:
  - {{ component_name }}
# Asn1_verbosity, choice in: none, info, annoying
Asn1_verbosity: {{ component.advanced_config.Asn1_verbosity | default("none", true) }}
gNBs:
  ##### Identification parameters:
  - gNB_ID: 0x{{ "%x" | format(component.config.gnbId) }}

    gNB_name: {{ component_name }}

    tracking_area_code: {{ component.config.tac }}

    plmn_list:
{% for plmn in component.config.plmnList %}
      - mcc: {{ plmn.plmnId.mcc }}
        mnc: {{ plmn.plmnId.mnc }}
        mnc_length: {{ plmn.plmnId.mncLength }}
        snssaiList:
{% for slice in plmn.snssaiList %}
          - sst: {{ slice.sst }}
{% if slice.sd %}
            sd: 0x{{ slice.sd }}
{% endif %}
{% endfor %}
{% endfor %}

    nr_cellid: {{ component.config.nrCellId }}

    ##### Physical parameters:
    min_rxtxtime: {{ 6 if component.advanced_config.min_rxtxtime is none else component.advanced_config.min_rxtxtime }}
{# optional gNBs parameters, rendered only when set (0 is a valid value) #}
{% for key in ["pdsch_AntennaPorts_XP", "pdsch_AntennaPorts_N1", "pusch_AntennaPorts", "do_CSIRS", "do_SRS"] %}
{% if component.advanced_config[key] is not none %}
    {{ key }}: {{ component.advanced_config[key] }}
{% endif %}
{% endfor %}

    servingCellConfigCommon:
      #spCellConfigCommon
      - physCellId: {{ component.config.physicalCellId }}
        #  downlinkConfigCommon
        #frequencyInfoDL
        absoluteFrequencySSB: {{ component.config.radioConfiguration.ssbArfcn }}
        dl_absoluteFrequencyPointA: {{ component.config.radioConfiguration.pointAFrequencyArfcn }}
        #scs-SpecificCarrierList
        dl_offstToCarrier: {{ 0 if component.advanced_config.dl_offstToCarrier is none else component.advanced_config.dl_offstToCarrier }}
        # subcarrierSpacing
        # 0=kHz15, 1=kHz30, 2=kHz60, 3=kHz120
        dl_subcarrierSpacing: {{ component.derived_radio_config.numerology }}
        dl_carrierBandwidth: {{ component.derived_radio_config.bandwidth_rb }}
        #initialDownlinkBWP
        #genericParameters
        initialDLBWPlocationAndBandwidth: {{ component.advanced_config.initialDLBWPlocationAndBandwidth | default(component.derived_radio_config.bwp_location_and_bandwidth, true) }}
        # subcarrierSpacing
        # 0=kHz15, 1=kHz30, 2=kHz60, 3=kHz120
        initialDLBWPsubcarrierSpacing: {{ component.advanced_config.initialDLBWPsubcarrierSpacing | default(1, true) }}
        #pdcch-ConfigCommon
        initialDLBWPcontrolResourceSetZero: {{ 11 if component.advanced_config.initialDLBWPcontrolResourceSetZero is none else component.advanced_config.initialDLBWPcontrolResourceSetZero }}
        initialDLBWPsearchSpaceZero: {{ 0 if component.advanced_config.initialDLBWPsearchSpaceZero is none else component.advanced_config.initialDLBWPsearchSpaceZero }}
        #uplinkConfigCommon
        #frequencyInfoUL
        ul_frequencyBand: {{ component.config.radioConfiguration.nrBand }}
{% if component.config.radioConfiguration.duplexMode == "fdd" %}
        ul_absoluteFrequencyPointA: {{ component.cderived_radio_config.ul_point_a_arfcn }}
{% endif %}
        #scs-SpecificCarrierList
        ul_offstToCarrier: {{ 0 if component.advanced_config.ul_offstToCarrier is none else component.advanced_config.ul_offstToCarrier }}
        # subcarrierSpacing
        # 0=kHz15, 1=kHz30, 2=kHz60, 3=kHz120
        ul_subcarrierSpacing: {{ component.derived_radio_config.numerology }}
        ul_carrierBandwidth: {{ component.derived_radio_config.bandwidth_rb }}
        pMax: {{ 20 if component.advanced_config.pMax is none else component.advanced_config.pMax }}
        #initialUplinkBWP
        #genericParameters
        initialULBWPlocationAndBandwidth: {{ component.advanced_config.initialULBWPlocationAndBandwidth | default(component.derived_radio_config.bwp_location_and_bandwidth, true) }}
        # subcarrierSpacing
        # 0=kHz15, 1=kHz30, 2=kHz60, 3=kHz120
        initialULBWPsubcarrierSpacing: {{ component.derived_radio_config.numerology }}
        #rach-ConfigCommon
        #rach-ConfigGeneric
        prach_ConfigurationIndex: {{ component.config.radioConfiguration.prachConfigurationIndex }}
        #prach_msg1_FDM
        #0 = one, 1=two, 2=four, 3=eight
        prach_msg1_FDM: {{ 0 if component.advanced_config.prach_msg1_FDM is none else component.advanced_config.prach_msg1_FDM }}
        prach_msg1_FrequencyStart: {{ component.config.radioConfiguration.msg1FrequencyStartPrb }}
{# 0 is a valid value (Benetel configuration): default only when unset #}
        zeroCorrelationZoneConfig: {{ 12 if component.advanced_config.zeroCorrelationZoneConfig is none else component.advanced_config.zeroCorrelationZoneConfig }}
        preambleReceivedTargetPower: {{ -104 if component.advanced_config.preambleReceivedTargetPower is none else component.advanced_config.preambleReceivedTargetPower }}
        #preamblTransMax (0...10) = (3,4,5,6,7,8,10,20,50,100,200)
        preambleTransMax: {{ 6 if component.advanced_config.preambleTransMax is none else component.advanced_config.preambleTransMax }}
        #powerRampingStep
        # 0=dB0,1=dB2,2=dB4,3=dB6
        powerRampingStep:  {{ 1 if component.advanced_config.powerRampingStep is none else component.advanced_config.powerRampingStep }}
        #ssb_perRACH_OccasionAndCB_PreamblesPerSSB_PR
        #1=oneeighth,2=onefourth,3=half,4=one,5=two,6=four,7=eight,8=sixteen
        ssb_perRACH_OccasionAndCB_PreamblesPerSSB_PR: {{ 4 if component.advanced_config.ssb_perRACH_OccasionAndCB_PreamblesPerSSB_PR is none else component.advanced_config.ssb_perRACH_OccasionAndCB_PreamblesPerSSB_PR }}
        #one (0..15) 4,8,12,16,...60,64
        ssb_perRACH_OccasionAndCB_PreamblesPerSSB: {{ 15 if component.advanced_config.ssb_perRACH_OccasionAndCB_PreamblesPerSSB is none else component.advanced_config.ssb_perRACH_OccasionAndCB_PreamblesPerSSB }}
        #ra_ContentionResolutionTimer
        #(0..7) 8,16,24,32,40,48,56,64
        ra_ContentionResolutionTimer: {{ 7 if component.advanced_config.ra_ContentionResolutionTimer is none else component.advanced_config.ra_ContentionResolutionTimer }}
        rsrp_ThresholdSSB: {{ 19 if component.advanced_config.rsrp_ThresholdSSB is none else component.advanced_config.rsrp_ThresholdSSB }}
        #prach-RootSequenceIndex_PR
        #1 = 839, 2 = 139
        prach_RootSequenceIndex_PR: {{ 2 if component.advanced_config.prach_RootSequenceIndex_PR is none else component.advanced_config.prach_RootSequenceIndex_PR }}
        prach_RootSequenceIndex: {{ 1 if component.advanced_config.prach_RootSequenceIndex is none else component.advanced_config.prach_RootSequenceIndex }}
        # SCS for msg1, can only be 15 for 30 kHz < 6 GHz, takes precedence over the one derived from prach-ConfigIndex
        msg1_SubcarrierSpacing: {{ component.derived_radio_config.ssb_numerology }}
        # restrictedSetConfig
        # 0=unrestricted, 1=restricted type A, 2=restricted type B
        restrictedSetConfig: {{ 0 if component.advanced_config.restrictedSetConfig is none else component.advanced_config.restrictedSetConfig }}
        msg3_DeltaPreamble: {{ 1 if component.advanced_config.msg3_DeltaPreamble is none else component.advanced_config.msg3_DeltaPreamble }}
        p0_NominalWithGrant: {{ -90 if component.advanced_config.p0_NominalWithGrant is none else component.advanced_config.p0_NominalWithGrant }}
        # pucch-ConfigCommon setup :
        # pucchGroupHopping
        # 0 = neither, 1= group hopping, 2=sequence hopping
        pucchGroupHopping: {{ 0 if component.advanced_config.pucchGroupHopping is none else component.advanced_config.pucchGroupHopping }}
        hoppingId: {{ 40 if component.advanced_config.hoppingId is none else component.advanced_config.hoppingId }}
        p0_nominal: {{ -90 if component.advanced_config.p0_nominal is none else component.advanced_config.p0_nominal }}
        ssb_PositionsInBurst_Bitmap: {{ 1 if component.advanced_config.ssb_PositionsInBurst_Bitmap is none else component.advanced_config.ssb_PositionsInBurst_Bitmap }}
        # ssb_periodicityServingCell
        # 0 = ms5, 1=ms10, 2=ms20, 3=ms40, 4=ms80, 5=ms160, 6=spare2, 7=spare1
        ssb_periodicityServingCell: {{ component.derived_radio_config.oai_ssb_periodicity }}
        # dmrs_TypeA_position
        # 0 = pos2, 1 = pos3
        dmrs_TypeA_Position: {{ 0 if component.advanced_config.dmrs_TypeA_Position is none else component.advanced_config.dmrs_TypeA_Position }}
        # subcarrierSpacing
        # 0=kHz15, 1=kHz30, 2=kHz60, 3=kHz120
        subcarrierSpacing: {{ component.derived_radio_config.numerology }}
        #tdd-UL-DL-ConfigurationCommon
        # subcarrierSpacing
        # 0=kHz15, 1=kHz30, 2=kHz60, 3=kHz120
        referenceSubcarrierSpacing: {{ component.derived_radio_config.numerology }}
{% if component.config.radioConfiguration.duplexMode == "tdd" %}
        # pattern1
        # dl_UL_TransmissionPeriodicity
        # 0=ms0p5, 1=ms0p625, 2=ms1, 3=ms1p25, 4=ms2, 5=ms2p5, 6=ms5, 7=ms10
        dl_UL_TransmissionPeriodicity: {{ component.derived_radio_config.oai_tdd_periodicity }}
        nrofDownlinkSlots: {{ component.config.radioConfiguration.tddConfiguration.nrofDownlinkSlots }}
        nrofDownlinkSymbols: {{ component.config.radioConfiguration.tddConfiguration.nrofDownlinkSymbols }}
        nrofUplinkSlots: {{ component.config.radioConfiguration.tddConfiguration.nrofUplinkSlots }}
        nrofUplinkSymbols: {{ component.config.radioConfiguration.tddConfiguration.nrofUplinkSymbols }}
{% endif %}
        ssPBCH_BlockPower: {{ component.config.radioConfiguration.ssbPbchBlockPowerDbm }}

    SCTP:
      SCTP_INSTREAMS: {{ component.config.sctpConfiguration.inStreams }}
      SCTP_OUTSTREAMS: {{ component.config.sctpConfiguration.outStreams }}

    ##### AMF parameters:
    amf_ip_address:
      - ipv4: {{ component.config.amf }}

    NETWORK_INTERFACES:
      GNB_IPV4_ADDRESS_FOR_NG_AMF: {{ component.config.n2.ipv4EndPointAddress }}
      GNB_IPV4_ADDRESS_FOR_NGU: {{ component.config.n3.ipv4EndPointAddress }}
      GNB_PORT_FOR_S1U: {{ component.config.n3.port }} # Spec 2152

MACRLCs:
  - num_cc: 1
    tr_s_preference: local_L1
    tr_n_preference: local_RRC
    pusch_TargetSNRx10: {{ 200 if component.advanced_config.pusch_TargetSNRx10 is none else component.advanced_config.pusch_TargetSNRx10 }}
    pucch_TargetSNRx10:  {{ 200 if component.advanced_config.pucch_TargetSNRx10 is none else component.advanced_config.pucch_TargetSNRx10 }}
{% for key in ["dl_bler_target_lower", "dl_bler_target_upper", "ul_bler_target_lower", "ul_bler_target_upper", "pusch_RSSI_Threshold", "pucch_RSSI_Threshold", "pusch_FailureThres", "ul_max_mcs", "stats_max_ue"] %}
{% if component.advanced_config[key] is not none %}
    {{ key }}: {{ component.advanced_config[key] }}
{% endif %}
{% endfor %}

L1s:
  - num_cc: 1
    tr_n_preference: local_mac
    prach_dtx_threshold: {{ 200 if component.advanced_config.prach_dtx_threshold is none else component.advanced_config.prach_dtx_threshold }}
    pucch0_dtx_threshold: {{ 150 if component.advanced_config.pucch0_dtx_threshold is none else component.advanced_config.pucch0_dtx_threshold }}
    ofdm_offset_divisor: {{ 8 if component.advanced_config.ofdm_offset_divisor is none else component.advanced_config.ofdm_offset_divisor }} # set this to UINT_MAX for offset 0
{% for key in ["pusch_dtx_threshold", "max_ldpc_iterations", "tx_amp_backoff_dB", "phase_compensation"] %}
{% if component.advanced_config[key] is not none %}
    {{ key }}: {{ component.advanced_config[key] }}
{% endif %}
{% endfor %}

RUs:
  - local_rf: {{ component.advanced_config.local_rf | default("yes", true) }}
    nb_tx: {{ component.config.ru.numberOfTxPorts }}
    nb_rx: {{ component.config.ru.numberOfRxPorts }}
    att_tx: {{ component.config.ru.txAttenuationDB }}
    att_rx: {{ component.config.ru.rxAttenuationDB }}
    bands: [{{ component.config.radioConfiguration.nrBand }}]
    max_pdschReferenceSignalPower: {{ -27 if component.advanced_config.max_pdschReferenceSignalPower is none else component.advanced_config.max_pdschReferenceSignalPower }}
    max_rxgain: {{ component.config.ru.rxGainDB }}
    eNB_instances: {{ component.config.ru.eNB_instances | default([0], true) }}
    sf_extension: {{ component.config.ru.sf_extension | default(0, true) }}
{% if component.advanced_config.do_precoding is not none %}
    do_precoding: {{ component.advanced_config.do_precoding }}
{% endif %}
{% if component.derived_radio_config.sdr_addrs %}
    sdr_addrs: {{ component.derived_radio_config.sdr_addrs }}
{% endif %}
{% if component.advanced_config and component.advanced_config.tr_preference %}
    tr_preference: {{ component.advanced_config.tr_preference }}
{% endif %}
{% if component.advanced_config and component.advanced_config.num_tp_cores %}
    num_tp_cores: {{ component.advanced_config.num_tp_cores }}
{% endif %}
{% if component.advanced_config and component.advanced_config.rxfh_core_id %}
    rxfh_core_id: {{ component.advanced_config.rxfh_core_id }}
{% endif %}
{% if component.advanced_config and component.advanced_config.txfh_core_id %}
    txfh_core_id: {{ component.advanced_config.txfh_core_id }}
{% endif %}
{% if component.advanced_config and component.advanced_config.tp_cores %}
    tp_cores: {{ component.advanced_config.tp_cores }}
{% endif %}
{% if component.advanced_config and component.advanced_config.nr_flag %}
    nr_flag: {{ component.advanced_config.nr_flag }}
{% endif %}
{% if component.advanced_config and component.advanced_config.sl_ahead %}
    sl_ahead: {{ component.advanced_config.sl_ahead }}
{% endif %}
{% if component.advanced_config and component.advanced_config.local_if_name %}
    local_if_name: "{{ component.advanced_config.local_if_name }}"
{% endif %}
{% if component.advanced_config and component.advanced_config.remote_address %}
    remote_address: "{{ component.advanced_config.remote_address }}"
{% endif %}
{% if component.advanced_config and component.advanced_config.local_address %}
    local_address: "{{ component.advanced_config.local_address }}"
{% endif %}
{% if component.advanced_config and component.advanced_config.local_portc %}
    local_portc: {{ component.advanced_config.local_portc }}
{% endif %}
{% if component.advanced_config and component.advanced_config.remote_portc %}
    remote_portc: {{ component.advanced_config.remote_portc }}
{% endif %}
{% if component.advanced_config and component.advanced_config.local_portd %}
    local_portd: {{ component.advanced_config.local_portd }}
{% endif %}
{% if component.advanced_config and component.advanced_config.remote_portd %}
    remote_portd: {{ component.advanced_config.remote_portd }}
{% endif %}

{% if component.config.ru.type == "simulated" %}
rfsimulator:
{% if component.advanced_config and component.advanced_config.rfsimulator %}
{{ component.advanced_config.rfsimulator | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  - serveraddr: server
    serverport: 4043
{% endif %}
{% endif %}

{% if component.config.ric %}
e2_agent:
  near_ric_ip_addr: {{ component.config.ric }}
  sm_dir: {{ component.advanced_config.sm_dir | default("/usr/local/lib/flexric/", true) }}
{% endif %}

security:
  # preferred ciphering algorithms
  # the first one of the list that an UE supports in chosen
  # valid values: nea0, nea1, nea2, nea3
  ciphering_algorithms:
{% for algorithm in component.config.securityAlgorithmConfiguration.cipheringOrder %}
    - {{ algorithm | lower }}
{% endfor %}
  # preferred integrity algorithms
  # the first one of the list that an UE supports in chosen
  # valid values: nia0, nia1, nia2, nia3
  integrity_algorithms:
{% for algorithm in component.config.securityAlgorithmConfiguration.integrityOrder %}
    - {{ algorithm | lower }}
{% endfor %}
  # setting 'drb_ciphering' to "no" disables ciphering for DRBs, no matter
  # what 'ciphering_algorithms' configures; same thing for 'drb_integrity'
  drb_ciphering: {{ component.advanced_config.drb_ciphering | default("yes", true) }}
  drb_integrity: {{ component.advanced_config.drb_integrity | default("no", true) }}

log_config:
{% if component.advanced_config and component.advanced_config.log_config %}
{{ component.advanced_config.log_config | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  global_log_level: info
  hw_log_level: info
  phy_log_level: info
  mac_log_level: info
  rlc_log_level: info
  pdcp_log_level: info
  rrc_log_level: info
  ngap_log_level: debug
  f1ap_log_level: debug
{% endif %}


{% if component.advanced_config and component.advanced_config.fhi_72 %}
fhi_72:
{{ component.advanced_config.fhi_72 | to_nice_yaml(indent=2) | indent(2, True) }}
{% endif %}

{% if component.advanced_config and component.advanced_config.thread_pool %}
thread-pool: {{ component.advanced_config.thread_pool }}
{% endif %}

{% if component.advanced_config and component.advanced_config.channelmod %}
channelmod:
{{ component.advanced_config.channelmod | to_nice_yaml(indent=2) | indent(2, True) }}
{% endif %}

{% endif %}
