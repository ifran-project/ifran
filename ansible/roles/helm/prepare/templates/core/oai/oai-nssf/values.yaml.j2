# Kubernetes distribution selector
# - "Vanilla"   → Community Kubernetes
# - "Openshift" → Red Hat OpenShift (requires UBI images)
kubernetesDistribution: Vanilla  

# container image configuration
nfimage:
  repository: {{ component.image.repository }}
  version: {{ component.image.image_tag }}      # Image tag (or "develop" for latest dev build)
  pullPolicy: {{ component.image.image_pull_policy }}  # Options: IfNotPresent, Always, Never

# Image pull secrets (useful for private registries or DockerHub rate limits)
imagePullSecrets:
{% if component.image.image_pull_secrets %}
{% for secret in component.image.image_pull_secrets %}
  - name: {{ secret.name }}
{% endfor %}
{% else %}
  []
{% endif %}


# Service account configuration
serviceAccount:
  create: true
  annotations: {}


{% if component.static_pod_ip %}
staticPodIp: "{{ component.static_pod_ip }}"
{% else %}
staticPodIp: null
{% endif %}


exposedPorts:
{% if component.exposed_ports %}
{% for name, port in component.exposed_ports.items() %}
  {{ name }}:
    port: {{ port.port }}
{% if port.protocol %}
    protocol: {{ port.protocol }}
{% endif %}
{% endfor %}
{% else %}
  {}
{% endif %}

podSecurityContext:
  runAsUser: {{ component.pod_security_context.run_as_user }}
  runAsGroup: {{ component.pod_security_context.run_as_group }}
  runAsNonRoot: {{ component.pod_security_context.run_as_non_root | lower }}
{% if component.pod_security_context.fs_group is not none %}
  fsGroup: {{ component.pod_security_context.fs_group }}
{% endif %}

securityContext:
{% if component.security_context %}
  privileged: {{ component.security_context.privileged | lower }}
  capabilities:
    add:
{% if component.security_context.capabilities.add %}
{% for cap in component.security_context.capabilities.add %}
      - {{ cap }}
{% endfor %}
{% else %}
      []
{% endif %}
    drop:
{% if component.security_context.capabilities.drop %}
{% for cap in component.security_context.capabilities.drop %}
      - {{ cap }}
{% endfor %}
{% else %}
      []
{% endif %}
{% else %}
  {}
{% endif %}

# Service type is fixed to ClusterIP (only for non-Multus interfaces, i.e., eth0)

# ───────────────────────────────────────────────
# Supported deployment modes:
# 1. N2 and SBI can share the same virtual interface (optional).
# 2. There can be only one entry of defaultRoute
#
# Note:  
# - Adapt the IP addresses to your lab environment.
# ───────────────────────────────────────────────

# If a particular interface is commented then it won't be created and instead of it eth0 will be used. 

multus:
  enabled: {{ component.multus.enabled | lower  }}
{% if component.multus.interfaces %}
  interfaces:
{% for iface in component.multus.interfaces %}
    - name: "{{ iface.name }}"
      hostInterface: "{{ iface.host_interface }}"
{% if iface.ip_address %}
      ipAdd: "{{ iface.ip_address }}"
{% endif %}
      netmask: "{{ iface.netmask }}"
{% if iface.default_route %}
      defaultRoute: "{{ iface.gateway }}"
{% elif iface.gateway %}
      gateway: "{{ iface.gateway }}"
{% endif %}
      enabled: {{ iface.enabled | lower }}
      type: {{ iface.type }}
      mode: "{{ iface.mode }}"
{% if iface.network %}
      network: "{{ iface.network }}"
{% endif %}
{% if iface.namespace %}
      namespace: "{{ iface.namespace }}"
{% endif %}
{% if iface.mtu %}
      mtu: {{ iface.mtu }}
{% endif %}
{% if iface.dns_servers %}
      dnsServers:
{% for dns in iface.dns_servers %}
        - "{{ dns }}"
{% endfor %}
{% endif %}
{% endfor %}
{% else %}
  interfaces: []
{% endif %}

start:
  {{ component.type }}: {{ component.start | lower }}      # If false → NF container sleeps (for manual debugging)
  tcpdump: {{ component.include_tcp_dump_container | lower }}  # Enable tcpdump container inside pod

includeTcpDumpContainer: {{ component.include_tcp_dump_container | lower}}  # If true, add tcpdump sidecar for debugging

# Tcpdump sidecar image (if enabled)
tcpdumpimage:
  repository: {{ component.tcp_dump_image.repository }}
  version: {{ component.tcp_dump_image.image_tag }}
  pullPolicy: {{ component.tcp_dump_image.image_pull_policy }}

#To store PCAP of NF in a sharedVolume so it can be easily fetched (PVC is created with NRF charts so make sure in NRF it is true)
persistent:
  sharedvolume: {{ component.tcp_dump_share_volume }}


# Resource requests and limits
# See: 
# https://kubernetes.io/docs/concepts/configuration/manage-resources-containers
# https://kubernetes.io/docs/concepts/workloads/pods/pod-qos
resources:
  define: {{ component.resources.define | lower }}

{% if component.resources.limits %}
  limits:
{% if component.resources.limits.nf %}
    nf:
      cpu: {{ component.resources.limits.nf.cpu }}
      memory: {{ component.resources.limits.nf.memory }}
{% endif %}
{% if component.resources.limits.tcpdump %}
    tcpdump:
      cpu: {{ component.resources.limits.tcpdump.cpu }}
      memory: {{ component.resources.limits.tcpdump.memory }}
{% endif %}
{% endif %}

{% if component.resources.requests %}
  requests:
{% if component.resources.requests.nf %}
    nf:
      cpu: {{ component.resources.requests.nf.cpu }}
      memory: {{ component.resources.requests.nf.memory }}
{% endif %}
{% if component.resources.requests.tcpdump %}
    tcpdump:
      cpu: {{ component.resources.requests.tcpdump.cpu }}
      memory: {{ component.resources.requests.tcpdump.memory }}
{% endif %}
{% endif %}

readinessProbe: {{ component.readiness_probe | lower }}
livenessProbe: {{ component.liveness_probe | lower }}

# Scheduling options
affinity:
{% if component.affinity %}
{{ component.affinity | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

terminationGracePeriodSeconds: 5

nodeSelector:
{% if component.node_selector %}
{{ component.node_selector | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

{% if component.node_name %}
nodeName: {{ component.node_name }}
{% endif %}

{% if component.tolerations %}
tolerations:
{{ component.tolerations | to_nice_yaml(indent=2) | indent(2, True) }}
{% endif %}

labels:
{% if component.labels %}
{{ component.labels | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

annotations:
{% if component.annotations %}
{{ component.annotations | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

nssf_slice_config: |
  info:
    version: 1.4.0
    description: OAI-NSSF Release v1.4.0

  configuration:
    nsiInfoList:
{% for nsi_info in component.config.nsiInfoList %}
{% for item in nsi_info.nsiInformationList %}
      - snssai:
          sst: {{ nsi_info.snssai.sst }}
{% if nsi_info.snssai.sd %}
          sd: '{{ nsi_info.snssai.sd }}'
{% endif %}
        nsiInformationList:
          nrfId: {{ item.nrfId }}
          nsiId: '{{ item.nsiId }}'
{% if item.nrfNfMgtUri %}
          nrfNfMgtUri: {{ item.nrfNfMgtUri }}
{% endif %}
{% endfor %}
{% endfor %}

    taInfoList:
{% for ta_info in component.config.taInfoList %}
      - tai:
          plmnId:
            mcc: '{{ ta_info.tai.plmnId.mcc }}'
            mnc: '{{ ta_info.tai.plmnId.mnc }}'
          tac: '{{ ta_info.tai.tac }}'
        supportedSnssaiList:
{% for snssai in ta_info.snssaiList %}
        - sst: {{ snssai.sst }}
{% if snssai.sd %}
          sd: '{{ snssai.sd }}'
{% endif %}
{% endfor %}
{% if ta_info.restrictedSnssaiList %}
        restrictedSnssaiList:
{% for restricted in ta_info.restrictedSnssaiList %}
        - homePlmnId:
            mcc: '{{ restricted.homePlmnId.mcc }}'
            mnc: '{{ restricted.homePlmnId.mnc }}'
          sNssaiList:
{% for snssai in restricted.snssaiList %}
          - sst: {{ snssai.sst }}
{% if snssai.sd %}
            sd: '{{ snssai.sd }}'
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}

    amfInfoList:
{% for amf_info in component.config.amfInfoList %}
      - targetAmfSet: {{ amf_info.targetAmfSet }}
        nrfAmfSet: {{ amf_info.nrfAmfSet }}
        nrfAmfSetNfMgtUri: {{ amf_info.nrfAmfSetNfMgtUri }}
        amfList:
{% for amf in amf_info.amfList %}
          - nfId: {{ amf.nfId }}
            supportedNssaiAvailabilityData:
              tai:
                plmnId:
                  mcc: {{ amf.supportedNssaiAvailabilityData.tai.plmnId.mcc }}
                  mnc: {{ amf.supportedNssaiAvailabilityData.tai.plmnId.mnc }}
                tac: {{ amf.supportedNssaiAvailabilityData.tai.tac }}
              supportedSnssaiList:
{% for snssai in amf.supportedNssaiAvailabilityData.snssaiList %}
                - sst: {{ snssai.sst }}
{% if snssai.sd %}
                  sd: '{{ snssai.sd }}'
{% endif %}
{% endfor %}
{% if amf.supportedNssaiAvailabilityData.taiList %}
              taiList:
{% for tai_info in amf.supportedNssaiAvailabilityData.taiList %}
                - tai:
                    plmnId:
                      mcc: {{ tai_info.tai.plmnId.mcc }}
                      mnc: {{ tai_info.tai.plmnId.mnc }}
                    tac: {{ tai_info.tai.tac }}
                  supportedSnssaiList:
{% for snssai in tai_info.snssaiList %}
                  - sst: {{ snssai.sst }}
{% if snssai.sd %}
                    sd: '{{ snssai.sd }}'
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}

    plmnInfoList:
{% for plmn_info in component.config.plmnInfoList %}
      - operatorName: {{ plmn_info.operatorName }}
        homePlmnId:
          mcc: '{{ plmn_info.homePlmnId.mcc }}'
          mnc: '{{ plmn_info.homePlmnId.mnc }}'
{% endfor %}
