{% if component.plain_text_config %}
{{ component.plain_text_config }}
{%- else %}

logger:
{% if component.advanced_config and component.advanced_config.logger %}
{{ component.advanced_config.logger | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  file:
    path: /opt/open5gs/var/log/open5gs/smf.log
  level: info   # fatal|error|warn|info(default)|debug|trace
{% endif %}

global:
{% if component.advanced_config and component.advanced_config.global_config %}
{{ component.advanced_config.global_config | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  max:
    ue: 1024  # The number of UE can be increased depending on memory size.
#    peer: 64
{% endif %}

smf:

{% if component.config.sbi.tls.enabled %}
  default:
    tls:
      server:
        scheme: https
        private_key: {{ component.config.sbi.tls.privateKey }}
        cert: {{ component.config.sbi.tls.certificate }}
        sslkeylogfile: {{ component.advanced_config.sslkeylogfile | default("/var/log/open5gs/tls/amf-server-sslkeylog.log", true) }}
{% if component.advanced_config and component.advanced_config.tls_client %}
      client:
{{ component.advanced_config.tls_client | to_nice_yaml(indent=8) | indent(8, True) }}
{% endif %}

{% endif %}

  sbi:
    server:
      - dev: {{ component.config.sbi.interfaceName }}
        port: {{ component.config.sbi.port }}

    client:
{% if component.advanced_config and component.advanced_config.sbi_client %}
{{ component.advanced_config.sbi_client | to_nice_yaml(indent=6) | indent(6, True) }}
{% else %}
      nrf:
        - uri: {{ component.config.nrfUri }}
{% endif %}

  metrics:
{% if component.advanced_config and component.advanced_config.metrics %}
{{ component.advanced_config.metrics | to_nice_yaml(indent=4) | indent(4, True) }}
{% else %}
    server:
      - dev: {{ component.config.n4.interfaceName }}
        port: 9090
{% endif %}

  pfcp:
    server:
      - dev: {{ component.config.n4.interfaceName }}
        port: {{ component.config.n4.port }}

    client:
{% if component.advanced_config and component.advanced_config.pfcp_client %}
{{ component.advanced_config.pfcp_client | to_nice_yaml(indent=6) | indent(6, True) }}
{% else %}
      upf:
{% for upf in component.config.upfs %}
        - address: {{ upf.config.n4.ipv4EndPointAddress }}
          dnn:
{% for slice in upf.config.snssaiList %}
{% for dnn in slice.dnns.values() %}
            - {{ dnn.name }}
{% endfor %}
{% endfor %}
{% endfor %}
{% endif %}

  gtpc:
{% if component.advanced_config and component.advanced_config.gtpc %}
{{ component.advanced_config.gtpc | to_nice_yaml(indent=4) | indent(4, True) }}
{% else %}
    server:
      - dev: {{ component.config.n4.interfaceName }}
{% endif %}

  gtpu:
{% if component.advanced_config and component.advanced_config.gtpu %}
{{ component.advanced_config.gtpu | to_nice_yaml(indent=4) | indent(4, True) }}
{% else %}
    server:
      - dev: {{ component.config.n4.interfaceName }}
{% endif %}

  session:
{% for slice in component.config.snssaiList %}
{% for dnn in slice.dnns.values() %}
    - subnet: {{ dnn.ipv4Network }}
      gateway: {{ dnn.ipv4Gateway }}
      dnn: {{ dnn.name }}
{% if dnn.ipv6Network %}
    - subnet: {{ dnn.ipv6Network }}
      gateway: {{ dnn.ipv6Gateway }}
      dnn: {{ dnn.name }}
{% endif %}
{% endfor %}
{% endfor %}

  dns:
{% if component.advanced_config and component.advanced_config.dns %}
{{ component.advanced_config.dns | to_nice_yaml(indent=4) | indent(4, True) }}
{% else %}
    - 8.8.8.8
    - 8.8.4.4
    - 2001:4860:4860::8888
    - 2001:4860:4860::8844
{% endif %}

  mtu: {{ component.advanced_config.mtu | default(1400, true) }}

################################################################################
# SMF Info
################################################################################
#  <SMF Selection - 5G Core only>
  info:
{% if component.advanced_config and component.advanced_config.info %}
{{ component.advanced_config.info | to_nice_yaml(indent=4) | indent(4, True) }}
{% else %}
    s_nssai:
{% for slice in component.config.snssaiList %}
      - sst: {{ slice.sst }}
{% if slice.sd %}
        sd: {{ slice.sd }}
{% endif %}
        dnn:
{% for dnn in slice.dnns.values() %}
          - {{ dnn.name }}
{% endfor %}
{% endfor %}
    tai:
{% for tai in component.config.taiList %}
      - plmn_id:
          mcc: {{ tai.plmnId.mcc }}
          mnc: {{ tai.plmnId.mnc }}
        tac: {{ tai.tac }}
{% endfor %}
{% endif %}

{% if component.advanced_config and component.advanced_config.p_cscf %}
  p-cscf:
{{ component.advanced_config.p_cscf | to_nice_yaml(indent=4) | indent(4, True) }}
{% endif %}

{% if component.advanced_config and component.advanced_config.ctf %}
  ctf:
{{ component.advanced_config.ctf | to_nice_yaml(indent=4) | indent(4, True) }}
{% endif %}

{% if component.advanced_config and component.advanced_config.freeDiameter %}
  freeDiameter: {{ component.advanced_config.freeDiameter }}
{% endif %}

{% if component.advanced_config and component.advanced_config.security_indication %}
  security_indication:
{{ component.advanced_config.security_indication | to_nice_yaml(indent=4) | indent(4, True) }}
{% endif %}

{% endif %}