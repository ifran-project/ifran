apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  name: "{{ node.name }}"
  criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ k8s_version.major }}.{{ k8s_version.minor }}.{{ k8s_version.patch }}
clusterName: {{ cluster_name }}
networking:
  serviceSubnet: {{ service_cidr }}
  podSubnet: {{ pod_network_cidr }}
  dnsDomain: cluster.local
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
cpuManagerPolicy: {{ kubelet_params.cpu_manager_policy }}
{% if kubelet_params.cpu_manager_policy_options %}
cpuManagerPolicyOptions:
{{ kubelet_params.cpu_manager_policy_options | to_nice_yaml(indent=2) | indent(2, True) }}
{% endif %}
{% if kubelet_params.reserved_system_cpus %}
reservedSystemCPUs: {{ kubelet_params.reserved_system_cpus | quote }}
{% endif %}
topologyManagerPolicy: {{ kubelet_params.topology_manager_policy }}
