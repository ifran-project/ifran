[Unit]
Description=Synchronize the system clock to the PHC of {{ fhi72_params.ptp.interface }}
After=ptp4l.service
Requires=ptp4l.service

[Service]
Type=simple
# Same options as the 5g_ansible setup/ptp role, but the PHC is given by its interface instead of /dev/ptp0
ExecStart=/usr/local/sbin/phc2sys -s {{ fhi72_params.ptp.interface }} -c CLOCK_REALTIME -r -n {{ fhi72_params.ptp.domain_number }} -w -m -l 7
Restart=always

[Install]
WantedBy=multi-user.target
