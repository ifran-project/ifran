#!/bin/bash
# Generated by ifran (k8s/fhi72 role): create the O-RAN 7.2 fronthaul VFs on {{ fhi72_params.fronthaul_interface }},
# set their MAC/VLAN from the PF and bind them to vfio-pci. Safe to run again.
set -euo pipefail

PF="{{ fhi72_params.fronthaul_interface }}"
NUM_VFS={{ fhi72_params.vfs | length }}
PF_SYS="/sys/class/net/${PF}/device"

if [ ! -e "${PF_SYS}/sriov_totalvfs" ]; then
  echo "ERROR: ${PF} does not exist or does not support SR-IOV" >&2
  exit 1
fi
TOTAL_VFS=$(cat "${PF_SYS}/sriov_totalvfs")
if [ "${NUM_VFS}" -gt "${TOTAL_VFS}" ]; then
  echo "ERROR: ${NUM_VFS} VFs requested on ${PF}, at most ${TOTAL_VFS} supported" >&2
  exit 1
fi

ip link set dev "${PF}" mtu {{ fhi72_params.mtu }} up

# the number of VFs can only be changed from 0
if [ "$(cat "${PF_SYS}/sriov_numvfs")" != "${NUM_VFS}" ]; then
  echo 0 > "${PF_SYS}/sriov_numvfs"
  echo "${NUM_VFS}" > "${PF_SYS}/sriov_numvfs"
fi

# VF settings are applied from the PF: DU MAC/VLAN expected by the RU, trust and no spoof check for DPDK
{% for vf in fhi72_params.vfs %}
ip link set dev "${PF}" vf {{ loop.index0 }} mac {{ vf.mac }} vlan {{ vf.vlan }} spoofchk off trust on
{% endfor %}

modprobe vfio-pci

for idx in $(seq 0 $((NUM_VFS - 1))); do
  VF_PCI=$(basename "$(readlink -f "${PF_SYS}/virtfn${idx}")")
  VF_SYS="/sys/bus/pci/devices/${VF_PCI}"
  DRIVER=""
  if [ -e "${VF_SYS}/driver" ]; then
    DRIVER=$(basename "$(readlink -f "${VF_SYS}/driver")")
  fi
  if [ "${DRIVER}" != "vfio-pci" ]; then
    echo vfio-pci > "${VF_SYS}/driver_override"
    if [ -n "${DRIVER}" ]; then
      echo "${VF_PCI}" > "${VF_SYS}/driver/unbind"
    fi
    echo "${VF_PCI}" > /sys/bus/pci/drivers_probe
  fi
  if [ ! -e "${VF_SYS}/driver" ] || [ "$(basename "$(readlink -f "${VF_SYS}/driver")")" != "vfio-pci" ]; then
    echo "ERROR: VF ${idx} (${VF_PCI}) is not bound to vfio-pci" >&2
    exit 1
  fi
  echo "VF ${idx}: ${VF_PCI} bound to vfio-pci"
done

ip link show dev "${PF}"
