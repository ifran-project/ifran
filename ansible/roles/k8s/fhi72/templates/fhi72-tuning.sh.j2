#!/bin/bash
# Generated by ifran (k8s/fhi72 role): node tuning for the O-RAN 7.2 fronthaul, as done by 5g_ansible for sopnode-f3
# (setup/optimization/nic and setup/optimization/cpu roles). Run at boot by ifran-fhi72-tuning.service, before
# kubelet, and by the k8s/fhi72 role. Safe to run again.
set -uo pipefail

PF="{{ fhi72_params.fronthaul_interface }}"
RESERVED_CPUS="{{ fhi72_params.reserved_cpus }}"
IRQ_PATTERN='{{ fhi72_irq_pattern }}'
status=0

# fronthaul PF: no adaptive interrupt moderation (prevents Tx timeouts) and large rings
# (ethtool returns 80 when the settings are already applied)
ethtool -C "${PF}" adaptive-rx off adaptive-tx off; rc=$?
[ "${rc}" -eq 0 ] || [ "${rc}" -eq 80 ] || { echo "ERROR: ethtool -C ${PF} failed (${rc})" >&2; status=1; }
{% if fhi72_params.ring_size is not none %}
ethtool -G "${PF}" rx {{ fhi72_params.ring_size }} tx {{ fhi72_params.ring_size }}; rc=$?
[ "${rc}" -eq 0 ] || [ "${rc}" -eq 80 ] || { echo "ERROR: ethtool -G ${PF} failed (${rc})" >&2; status=1; }
{% endif %}

# fronthaul VFs (MAC/VLAN/trust, vfio-pci)
/usr/local/sbin/ifran-fhi72-vfs.sh || status=1

# NIC IRQs on the housekeeping CPUs: an unpinned PF IRQ on a gNB core is starved by the DPDK busy polling
# (Tx timeout, ice reset blocked holding rtnl, node unreachable). The vfio-msix IRQs of the DPDK VFs do not match.
n=0; failed=""
for irq in $(grep -E "${IRQ_PATTERN}" /proc/interrupts | cut -d: -f1); do
  if { echo "${RESERVED_CPUS}" > "/proc/irq/${irq}/smp_affinity_list"; } 2>/dev/null; then
    n=$((n+1))
  else
    failed="${failed} ${irq}"
  fi
done
echo "pinned ${n} IRQs on ${RESERVED_CPUS}"
[ -z "${failed}" ] || echo "failed IRQs:${failed}" >&2
[ "${n}" -gt 0 ] || { echo "ERROR: no IRQ matches '${IRQ_PATTERN}'" >&2; status=1; }

# performance CPU frequency governor (with intel_pstate=disable, the default governor is not performance)
n=0
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  [ -e "${g}" ] || continue
  [ "$(cat "${g}")" = performance ] && continue
  echo performance > "${g}" && n=$((n+1)) || status=1
done
echo "performance governor set on ${n} CPUs"

# PREEMPT_RT only (no such threads otherwise): a SCHED_FIFO busy-poll thread of the gNB (xran, prio 98) can preempt
# the per-CPU RCU kthreads inside a read-side section, then no RCU grace period ends and the node goes NotReady.
# Run rcuc/N and rcub/N above the pollers, as rcutree.kthread_prio=99 would do at boot.
n=0
for p in $(pgrep '^rcu[cb]/'); do
  [ "$(chrt -p "${p}" | awk -F': ' '/priority/ {print $2}')" = 99 ] && continue
  chrt -f -p 99 "${p}" && n=$((n+1)) || status=1
done
echo "RCU kthreads raised to SCHED_FIFO 99: ${n}"

exit "${status}"
