[Unit]
Description=ifran O-RAN 7.2 fronthaul node tuning (VFs, NIC IRQs, CPU governor, RCU kthreads)
Wants=network-online.target
After=network-online.target
# the SR-IOV device plugin, started by kubelet, discovers the VFs at startup
Before=kubelet.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ifran-fhi72-tuning.sh
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
