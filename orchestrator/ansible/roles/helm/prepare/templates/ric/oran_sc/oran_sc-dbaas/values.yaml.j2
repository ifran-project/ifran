common:
  namespace:
    platform: {{ component.namespace }}
    xapp: ricxapp
    infra: ricinfra

dbaas:
  image:
    registry: {{ component.image.repository.rsplit('/', 1)[0] }}
    name: {{ component.image.repository.rsplit('/', 1)[1] }}
    tag: {{ component.image.image_tag }}
  imagePullPolicy: {{ component.image.image_pull_policy }}
  enableHighAvailability: false

  redis:
    masterGroupName: dbaasmaster
    sa_config:
      ## For /data/conf/redis.conf
      # For now DBAAS has no discs, that's why disable AOF and RDB file snapshot saving
      appendonly: "no"
      save: ""
      protected-mode: "no"
      loadmodule: "/usr/local/libexec/redismodule/libredismodule.so"
      bind: 0.0.0.0
    ha_config:
      ## For /data/conf/redis.conf
      # For now DBAAS has no discs, that's why disable AOF and RDB file snapshot saving
      appendonly: "no"
      save: ""
      min-slaves-to-write: 1
      min-slaves-max-lag: 5
      maxmemory: "0"
      maxmemory-policy: "volatile-lru"
      protected-mode: "no"
      loadmodule: "/usr/local/libexec/redismodule/libredismodule.so"

  sentinel:
    quorum: 2
    protected-mode: "no"
    config:
      ## For /data/conf/sentinel.conf
      down-after-milliseconds: 5000
      failover-timeout: 60000
      parallel-syncs: 1

  saReplicas: 1
  haReplicas: 3
  #Timeout command below requires -t flag if installed DBAAS image is older than
  #0.5.0. Reason is that DBAAS image version 0.5.0 and newer ones are based on
  #newer Alpine 3.11 OS version and in this Alpine version timeout command
  #doesn't have -t flag anymore.
  probeTimeoutCommand: "timeout"
  #probeTimeoutCommand: "timeout -t"
  probeTimeout: 10

# Scheduling options
affinity:
{% if component.affinity %}
{{ component.affinity | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

terminationGracePeriodSeconds: 5

nodeSelector:
{% if component.node_selector %}
{{ component.node_selector | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

{% if component.node_name %}
nodeName: {{ component.node_name }}
{% endif %}

{% if component.tolerations %}
tolerations:
{{ component.tolerations | to_nice_yaml(indent=2) | indent(2, True) }}
{% endif %}
