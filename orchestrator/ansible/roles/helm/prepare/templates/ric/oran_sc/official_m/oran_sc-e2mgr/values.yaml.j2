common:
  namespace:
    platform: {{ component.namespace }}
    xapp: ricxapp
    infra: ricinfra

e2mgr:
  image:
    registry: {{ component.image.repository.rsplit('/', 1)[0] }}
    name: {{ component.image.repository.rsplit('/', 1)[1] }}
    tag: {{ component.image.image_tag }}
  baseUrl: "http://service-{{ component.namespace }}-rtmgr-http:3800/ric/v1/handles/"
  privilegedmode: {{ (component.security_context.privileged if component.security_context else false) | lower }}
  globalRicId:
    ricId: "AACCE"
    mcc: "310"
    mnc: "411"
  rnibWriter:
    stateChangeMessageChannel: RAN_CONNECTION_STATUS_CHANGE
    ranManipulationMessageChannel: RAN_MANIPULATION
