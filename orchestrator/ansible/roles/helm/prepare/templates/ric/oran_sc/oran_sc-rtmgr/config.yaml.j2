"PlatformComponents":
{% if 'e2mgr' in component.ric_type_services %}
  - "name": "E2MAN"
    "fqdn": "{{ component.ric_type_services.e2mgr }}.{{ component.namespace }}"
    "port": 3801
{% endif %}
{% if 'submgr' in component.ric_type_services %}
  - "name": "SUBMAN"
    "fqdn": "{{ component.ric_type_services.submgr }}.{{ component.namespace }}"
    "port": 4560
{% endif %}
{% if 'a1mediator' in component.ric_type_services %}
  - "name": "A1MEDIATOR"
    "fqdn": "{{ component.ric_type_services.a1mediator }}.{{ component.namespace }}"
    "port": 4562
{% endif %}
{% if 'e2mgr' in component.ric_type_services %}
# RtMgr resolves route names through this explicit message-type table.
"messagetypes":
  - "RIC_HEALTH_CHECK_REQ=100"
  - "RIC_HEALTH_CHECK_RESP=101"
  - "RIC_SCTP_CONNECTION_FAILURE=1080"
  - "RIC_SCTP_CLEAR_ALL=1090"
  - "E2_TERM_INIT=1100"
  - "E2_TERM_KEEP_ALIVE_REQ=1101"
  - "E2_TERM_KEEP_ALIVE_RESP=1102"
  - "RIC_SGNB_ADDITION_REQ=10270"
  - "RIC_SGNB_ADDITION_ACK=10271"
  - "RIC_SGNB_ADDITION_REJECT=10272"
  - "RIC_E2_SETUP_REQ=12001"
  - "RIC_E2_SETUP_RESP=12002"
  - "RIC_E2_SETUP_FAILURE=12003"
  - "RIC_E2_RESET_REQ=12004"
  - "RIC_E2_RESET_RESP=12005"
  - "RIC_ERROR_INDICATION=12007"
  - "RIC_SUB_REQ=12010"
  - "RIC_SUB_RESP=12011"
  - "RIC_SUB_FAILURE=12012"
  - "RIC_SUB_DEL_REQ=12020"
  - "RIC_SUB_DEL_RESP=12021"
  - "RIC_SUB_DEL_FAILURE=12022"
  - "RIC_SUB_DEL_REQUIRED=12023"
  - "RIC_SERVICE_UPDATE=12030"
  - "RIC_SERVICE_UPDATE_ACK=12031"
  - "RIC_SERVICE_UPDATE_FAILURE=12032"
  - "RIC_CONTROL_REQ=12040"
  - "RIC_CONTROL_ACK=12041"
  - "RIC_CONTROL_FAILURE=12042"
  - "RIC_INDICATION=12050"
  - "RIC_E2NODE_CONFIG_UPDATE=12070"
  - "RIC_E2NODE_CONFIG_UPDATE_ACK=12071"
  - "RIC_E2NODE_CONFIG_UPDATE_FAILURE=12072"
{% if 'a1mediator' in component.ric_type_services %}
  - "A1_POLICY_REQ=20010"
  - "A1_POLICY_RESP=20011"
  - "A1_POLICY_QUERY=20012"
{% endif %}
# Keep E2 platform routes when RtMgr replaces the seed routing table.
"PlatformRoutes":
  - "messagetype": "E2_TERM_INIT"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "E2MAN"
    "meid": ""
  - "messagetype": "RIC_E2_SETUP_REQ"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "E2MAN"
    "meid": ""
{% if 'submgr' in component.ric_type_services %}
  # Subscription requests go through SubMgr; responses return to it.
  - "messagetype": "RIC_SUB_REQ"
    "senderendpoint": "SUBMAN"
    "subscriptionid": -1
    "endpoint": ""
    "meid": "%meid"
  - "messagetype": "RIC_SUB_DEL_REQ"
    "senderendpoint": "SUBMAN"
    "subscriptionid": -1
    "endpoint": ""
    "meid": "%meid"
  - "messagetype": "RIC_SUB_RESP"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "SUBMAN"
    "meid": ""
  - "messagetype": "RIC_SUB_FAILURE"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "SUBMAN"
    "meid": ""
  - "messagetype": "RIC_SUB_DEL_RESP"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "SUBMAN"
    "meid": ""
  - "messagetype": "RIC_SUB_DEL_FAILURE"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "SUBMAN"
    "meid": ""
  - "messagetype": "RIC_SUB_DEL_REQUIRED"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "SUBMAN"
    "meid": ""
{% endif %}
{% if 'a1mediator' in component.ric_type_services %}
  - "messagetype": "A1_POLICY_QUERY"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "A1MEDIATOR"
    "meid": ""
  - "messagetype": "A1_POLICY_RESP"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "A1MEDIATOR"
    "meid": ""
{% endif %}
{% endif %}
{% if 'appmgr' in component.ric_type_services %}
# RtMgr loads the initial xApp list from AppMgr.
"XMURL": "http://{{ component.ric_type_services.appmgr }}.{{ component.namespace }}.svc.cluster.local:8080/ric/v1/xapps"
{% endif %}
{% if 'e2mgr' in component.ric_type_services %}
# RtMgr retrieves the active E2Term instances from E2Mgr.
"E2MURL": "http://{{ component.ric_type_services.e2mgr }}.{{ component.namespace }}.svc.cluster.local:3800/v1/e2t/list"
{% endif %}
{% if 'submgr' in component.ric_type_services %}
# The xApp framework builds the subscription URL from this host.
"controls":
  "subscription":
    "host": "{{ component.ric_type_services.submgr }}.{{ component.namespace }}.svc.cluster.local:8088"
{% endif %}
"RTFILE": "/db/rt.json"
"CFGFILE": "/cfg/rtmgr-config.yaml"
"RPE": "rmrpush"
"SBI": "rmrpush"
"SBIURL": "0.0.0.0"
"NBI": "httpRESTful"
"NBIURL": "http://{{ component.service_name }}.{{ component.namespace }}.svc.cluster.local:3800"
"SDL": "file"
"local":
  "host": ":8080"
"logger":
  "level": 4
"rmr":
  "protPort": "tcp:4560"
  "maxSize": 65536
  "numWorkers": 1
