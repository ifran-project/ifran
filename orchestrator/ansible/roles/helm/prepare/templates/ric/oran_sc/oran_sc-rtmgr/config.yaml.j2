"PlatformComponents":
{% if 'e2mgr' in component.ric_type_services %}
  - "name": "E2MAN"
    "fqdn": "{{ component.ric_type_services.e2mgr }}"
    "port": 3801
{% endif %}
{% if 'submgr' in component.ric_type_services %}
  - "name": "SUBMAN"
    "fqdn": "{{ component.ric_type_services.submgr }}"
    "port": 4560
{% endif %}
{% if 'e2mgr' in component.ric_type_services %}
# RtMgr resolves route names through this explicit message-type table.
"messagetypes":
  - "RIC_SCTP_CONNECTION_FAILURE=1080"
  - "RIC_SCTP_CLEAR_ALL=1090"
  - "E2_TERM_INIT=1100"
  - "E2_TERM_KEEP_ALIVE_REQ=1101"
  - "E2_TERM_KEEP_ALIVE_RESP=1102"
  - "RIC_E2_SETUP_REQ=12001"
  - "RIC_E2_SETUP_RESP=12002"
  - "RIC_E2_SETUP_FAILURE=12003"
# Keep E2 platform routes when RtMgr replaces the seed routing table.
"PlatformRoutes":
  - "messagetype": "E2_TERM_INIT"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "E2MAN"
    "meid": ""
  - "messagetype": "RIC_E2_SETUP_REQ"
    "senderendpoint": ""
    "subscriptionid": -1
    "endpoint": "E2MAN"
    "meid": ""
{% endif %}
{% if 'appmgr' in component.ric_type_services %}
# RtMgr loads the initial xApp list from AppMgr.
"XMURL": "http://{{ component.ric_type_services.appmgr }}:8080/ric/v1/xapps"
{% endif %}
{% if 'e2mgr' in component.ric_type_services %}
# RtMgr retrieves the active E2Term instances from E2Mgr.
"E2MURL": "http://{{ component.ric_type_services.e2mgr }}:3800/v1/e2t/list"
{% endif %}
{% if 'submgr' in component.ric_type_services %}
# The xApp framework builds the subscription URL from this host.
"controls":
  "subscription":
    "host": "{{ component.ric_type_services.submgr }}:8088"
{% endif %}
"RTFILE": "/db/rt.json"
"CFGFILE": "/cfg/rtmgr-config.yaml"
"RPE": "rmrpush"
"SBI": "rmrpush"
"SBIURL": "0.0.0.0"
"NBI": "httpRESTful"
"NBIURL": "http://{{ component.service_name }}:3800"
"SDL": "file"
"local":
  "host": ":8080"
"logger":
  "level": 4
"rmr":
  "protPort": "tcp:4560"
  "maxSize": 65536
  "numWorkers": 1
