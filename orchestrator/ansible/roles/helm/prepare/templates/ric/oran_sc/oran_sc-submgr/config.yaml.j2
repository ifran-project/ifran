"local":
  "host": ":8080"
"logger":
  "level": 4
"rmr":
  "protPort": "tcp:4560"
  "maxSize": 8192
  "numWorkers": 1
{% if 'rtmgr' in component.ric_type_services %}
"rtmgr":
  "hostAddr": "{{ component.ric_type_services.rtmgr }}"
  "port": 3800
  "baseUrl": "/ric/v1"
{% endif %}
"db":
  "sessionNamespace": "XMSession"
  "host": ":6379"
  "prot": "tcp"
  "maxIdle": 80
  "maxActive": 12000
"controls":
  "e2tSubReqTimeout_ms": 2000
  "e2tSubDelReqTime_ms": 2000
  "e2tRecvMsgTimeout_ms": 2000
  "e2tMaxSubReqTryCount": 2
  "e2tMaxSubDelReqTryCount": 2
  "checkE2State": "true"
  "readSubsFromDb": "true"
  "dbRetryForever": "true"
