componentName: appmgr
image:
  repository: {{ component.image.repository }}
  tag: {{ component.image.image_tag }}
  pullPolicy: {{ component.image.image_pull_policy }}

command: []
args: []
ports:
  - {name: http, port: 8080, protocol: TCP}
  - {name: rmrdata, port: 4560, protocol: TCP}
  - {name: rmrroute, port: 4561, protocol: TCP}
env:
  NAME: xappmgr
  HELMVERSION: v3
  RMR_RTG_SVC: "4561"
  RMR_SRC_ID: {{ component.advanced_config.service_name | default("", true) }}
{% if 'dbaas' in component.advanced_config.ric_type_services %}
  DBAAS_SERVICE_HOST: {{ component.advanced_config.ric_type_services.dbaas }}
  DBAAS_SERVICE_PORT: "6379"
{% endif %}
configMountPath: /opt/ric/config/appmgr.yaml
routerMountPath: null
dataMountPath: /tmp
router: |-
  newrt|start
  newrt|end

helmRepository:
  enabled: {{ ('chartmuseum' in component.advanced_config.ric_type_services) | lower }}

imagePullSecrets:
{% if component.image.image_pull_secrets %}
{% for secret in component.image.image_pull_secrets %}
  - name: {{ secret.name }}
{% endfor %}
{% else %}
  []
{% endif %}

podSecurityContext:
  runAsUser: {{ component.pod_security_context.run_as_user }}
  runAsGroup: {{ component.pod_security_context.run_as_group }}
  runAsNonRoot: {{ component.pod_security_context.run_as_non_root | lower }}
{% if component.pod_security_context.fs_group is not none %}
  fsGroup: {{ component.pod_security_context.fs_group }}
{% endif %}

{% if component.security_context %}
securityContext:
  privileged: {{ component.security_context.privileged | lower }}
{% else %}
securityContext: {}
{% endif %}

{% if component.resources.define %}
resources:
  requests:
    cpu: {{ component.resources.requests.nf.cpu }}
    memory: {{ component.resources.requests.nf.memory }}
  limits:
    cpu: {{ component.resources.limits.nf.cpu }}
    memory: {{ component.resources.limits.nf.memory }}
{% else %}
resources: {}
{% endif %}


# Scheduling options
affinity:
{% if component.affinity %}
{{ component.affinity | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

terminationGracePeriodSeconds: 5

nodeSelector:
{% if component.node_selector %}
{{ component.node_selector | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

{% if component.node_name %}
nodeName: {{ component.node_name }}
{% endif %}

{% if component.tolerations %}
tolerations:
{{ component.tolerations | to_nice_yaml(indent=2) | indent(2, True) }}
{% endif %}
