common:
  namespace:
    platform: {{ component.namespace }}
    xapp: ricxapp
    infra: ricinfra

a1mediator:
  image:
    registry: {{ component.image.repository.rsplit('/', 1)[0] }}
    name: {{ component.image.repository.rsplit('/', 1)[1] }}
    tag: {{ component.image.image_tag }}
  rmr_timeout_config:
    a1_rcv_retry_times: 20
    ins_del_no_resp_ttl: 5
    ins_del_resp_ttl: 10

# Scheduling options
affinity:
{% if component.affinity %}
{{ component.affinity | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

terminationGracePeriodSeconds: 5

nodeSelector:
{% if component.node_selector %}
{{ component.node_selector | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  {}
{% endif %}

{% if component.node_name %}
nodeName: {{ component.node_name }}
{% endif %}

{% if component.tolerations %}
tolerations:
{{ component.tolerations | to_nice_yaml(indent=2) | indent(2, True) }}
{% endif %}
