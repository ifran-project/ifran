{% set overrides_yaml %}
common:
  namespace:
    platform: {{ component.namespace }}
    xapp: ricxapp
    infra: ricinfra

a1mediator:
  image:
    registry: {{ component.image.repository.rsplit('/', 1)[0] }}
    name: {{ component.image.repository.rsplit('/', 1)[1] }}
    tag: {{ component.image.image_tag }}
  rmr_timeout_config:
    a1_rcv_retry_times: 20
    ins_del_no_resp_ttl: 5
    ins_del_resp_ttl: 10
{% endset %}
{% set defaults = lookup('ansible.builtin.file', role_path ~ '/files/ric/oran_sc/oran_sc-a1mediator/values.yaml') | from_yaml %}
{{ defaults | combine(overrides_yaml | from_yaml, recursive=true) | to_nice_yaml }}
