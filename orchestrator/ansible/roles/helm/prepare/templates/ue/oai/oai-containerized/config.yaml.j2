{% if component.plain_text_config %}
{{ component.plain_text_config }}
{%- else %}
uicc0 = {
    imsi = "{{ component.config.supi }}";
    key = "{{ component.config.authenticationData.k }}";
    opc = "{{ component.config.authenticationData.opc }}";

    pdu_sessions = (
{% for pdu_session in component.config.pduSessions %}
        {
            dnn = "{{ component.config.subscriptions[pdu_session.subscriptionIndex].dnn.name }}";
            nssai_sst = {{ component.config.subscriptions[pdu_session.subscriptionIndex].snssai.sst }};
{% if component.config.subscriptions[pdu_session.subscriptionIndex].snssai.sd is not none %}
            nssai_sd = 0x{{ component.config.subscriptions[pdu_session.subscriptionIndex].snssai.sd }};
{% endif %}
            type = "{{ component.config.subscriptions[pdu_session.subscriptionIndex].dnn.pduSessionType | upper }}";
        }{% if not loop.last %},{% endif %}
{% endfor %}
    );
}

RUs = (
    {
        nb_tx = {{ component.config.ru.numberOfTxPorts }};
        nb_rx = {{ component.config.ru.numberOfRxPorts }};
        att_tx = {{ component.config.ru.txAttenuationDB }};
        att_rx = {{ component.config.ru.rxAttenuationDB }};
        max_rxgain = {{ component.config.ru.rxGainDB }};
        clock_src = "{{ component.config.ru.clockSource }}";
        time_src = "{{ component.config.ru.timeSource }}";
        tune_offset = {{ component.advanced_config.tune_offset | default(0.0, true) }};
        if_freq = {{ component.advanced_config.if_freq | default(0, true) }};
        if_offset = {{ component.advanced_config.if_offset | default(0, true) }};
{% if component.config.ru.ips %}
        sdr_addrs = "addr={{ component.config.ru.ips[0] }},clock_source={{ component.config.ru.clockSource }},time_source={{ component.config.ru.timeSource }}";
{% endif %}
    }
);

{% if component.config.ru.type == "simulated" %}
{% if component.config.gnbs[0].implementation == "oai" %}
rfsimulator = (
    {
        serveraddr = "{{ component.config.gnbs[0].gnb_ip }}";
        serverport = 4043;
    }
);
{% endif %}
{% if component.config.gnbs[0].implementation == "ocudu" %}
# for ocudu, zmq is used as rf simulator
device = {
  name = "oai_zmqdevif";
};

zmq = (
  {
    tx_channels = ( "tcp://{{ component.static_pod_ip }}:2001" );
    rx_channels = ( "tcp://{{ component.config.gnbs[0].gnb_ip }}:2000" );
  }
);
{% endif %}
{% endif %}

cells = (
    {
        ru_id = 0;
        band = {{ component.config.gnbs[0].config.radioConfiguration.nrBand }};
        rf_freq = {{ component.derived_radio_config.dl_carrier_freq_hz }}L;
        rf_offset = {{ component.derived_radio_config.offset_hz }};
        numerology = {{ component.derived_radio_config.numerology }};
        N_RB_DL = {{ component.derived_radio_config.bandwidth_rb }};
        ssb_start = {{ component.derived_radio_config.ssb_start }};
    }
);

{% if component.advanced_config and component.advanced_config.position0 %}
position0 = {{ component.advanced_config.position0 }}
{% endif %}

{% if component.advanced_config and component.advanced_config.channelmod %}
channelmod = {{ component.advanced_config.channelmod }}
{% endif %}

{% if component.advanced_config and component.advanced_config.thread_pool %}
thread-pool = {{ component.advanced_config.thread_pool }}
{% endif %}

{% endif %}