{% if component.plain_text_config %}
{{ component.plain_text_config }}
{%- else %}
Active_gNBs:
  - {{ component_name }}
# Asn1_verbosity, choice in: none, info, annoying
Asn1_verbosity: {{ component.advanced_config.Asn1_verbosity | default("none", true) }}
Num_Threads_PUSCH: {{ component.advanced_config.Num_Threads_PUSCH | default(8, true) }}
sa: {{ component.advanced_config.sa | default(1, true) }}

gNBs:
  - gNB_ID: 0x{{ "%x" | format(component.config.gnbId) }}
    gNB_name: {{ component_name }}
    tracking_area_code: {{ component.config.tac }}
    plmn_list:
{% for plmn in component.config.plmnList %}
      - mcc: {{ plmn.plmnId.mcc }}
        mnc: {{ plmn.plmnId.mnc }}
        mnc_length: {{ plmn.plmnId.mncLength }}
{% for slice in plmn.snssaiList %}
        snssaiList:
          - sst: {{ slice.sst }}
{% if slice.sd %}
            sd: 0x{{ slice.sd }}
{% endif %}
{% endfor %}
{% endfor %}

    nr_cellid: {{ component.config.nrCellId }}

    tr_s_preference: "f1"

    local_s_address: "{{ component.config.f1c.ipv4EndPointAddress }}"
    remote_s_address: "{{ component.advanced_config.du_ip | default("0.0.0.0", true) }}"
    local_s_portc: "{{ component.config.f1c.port }}"
    remote_s_portc: "{{ component.config.f1c.port }}"

    # ------- SCTP definitions
    SCTP:
      SCTP_INSTREAMS: {{ component.config.sctpConfiguration.inStreams }}
      SCTP_OUTSTREAMS: {{ component.config.sctpConfiguration.outStreams }}

    # -------- AMF parameters
    amf_ip_address:
      - ipv4: {{ component.config.amf.config.n2.ipv4EndPointAddress }}

    E1_INTERFACE:
      - type: "cp"
        ipv4_cucp: "{{ component.config.e1.ipv4EndPointAddress }}"
        port_cucp: "{{ component.config.e1.port }}"
        ipv4_cuup: "{{ component.advanced_config.cu_up_ip | default("0.0.0.0", true) }}"
        port_cuup: "{{ component.config.e1.port }}"

    NETWORK_INTERFACES:
      GNB_IPV4_ADDRESS_FOR_NG_AMF: {{ component.config.n2.ipv4EndPointAddress }}

security:
  # preferred ciphering algorithms
  # the first one of the list that an UE supports in chosen
  # valid values: nea0, nea1, nea2, nea3
  ciphering_algorithms:
{% for algorithm in component.config.securityAlgorithmConfiguration.cipheringOrder %}
    - {{ algorithm | lower }}
{% endfor %}
  # preferred integrity algorithms
  # the first one of the list that an UE supports in chosen
  # valid values: nia0, nia1, nia2, nia3
  integrity_algorithms:
{% for algorithm in component.config.securityAlgorithmConfiguration.integrityOrder %}
    - {{ algorithm | lower }}
{% endfor %}
  # setting 'drb_ciphering' to "no" disables ciphering for DRBs, no matter
  # what 'ciphering_algorithms' configures; same thing for 'drb_integrity'
  drb_ciphering: {{ component.advanced_config.drb_ciphering | default("yes", true) }}
  drb_integrity: {{ component.advanced_config.drb_integrity | default("no", true) }}

{% if component.config.ric %}
e2_agent:
  near_ric_ip_addr: {{ component.config.ric }}
  sm_dir: {{ component.advanced_config.sm_dir | default("/usr/local/lib/flexric/", true) }}
{% endif %}

log_config:
{% if component.advanced_config and component.advanced_config.log_config %}
{{ component.advanced_config.log_config | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  global_log_level: "info"
  hw_log_level: "info"
  phy_log_level: "info"
  mac_log_level: "info"
  rlc_log_level: "debug"
  pdcp_log_level: "info"
  rrc_log_level: "info"
  f1ap_log_level: "info"
  ngap_log_level: "debug"
{% endif %}
{% endif %}
