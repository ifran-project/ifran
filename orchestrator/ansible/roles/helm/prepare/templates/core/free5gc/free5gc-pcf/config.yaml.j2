{% if component.plain_text_config %}
{{ component.plain_text_config }}
{%- else %}

info:
{% if component.advanced_config and component.advanced_config.info %}
{{ component.advanced_config.info | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  version: 1.0.2
  description: PCF initial local configuration
{% endif %}

configuration:
  pcfName: {{ chart_name }} # the name of this PCF

  sbi: # Service-based interface information
    scheme: {{ component.config.sbi.scheme }} # the protocol for sbi (http or https)
    registerIPv4: {{ chart_name }} # IP used to register to NRF
    bindingIPv4: {{ component.config.sbi.ipv4EndPointAddress }}  # IP used to bind the service
    port: {{ component.config.sbi.port }} # port used to bind the service
{% if component.config.sbi.tls.enabled %}
    tls: # the local path of TLS key
      pem: {{ component.config.sbi.tls.certificate }} # PCF TLS Certificate
      key: {{ component.config.sbi.tls.privateKey }} # PCF TLS Private key
{% endif %}

  timeFormat: {{ component.advanced_config.timeFormat | default("2019-01-02 15:04:05", true) }} # time format of this PCF

  defaultBdtRefId: {{ component.advanced_config.defaultBdtRefId | default("BdtPolicyId-", true) }}   # BDT Reference ID, indicating transfer policies of background data transfer.

  nrfUri: {{ component.config.nrfUri }} # a valid URI of NRF

{% if component.advanced_config and component.advanced_config.nrfCertPem %}
  nrfCertPem: {{ component.advanced_config.nrfCertPem }} # NRF Certificate
{% endif %}

  bsf:
    enable: {{ component.advanced_config.bsf_enable | default("true", true) | lower }}  # Enable BSF integration (set to false to disable BSF completely)

  serviceList:   # the SBI services provided by this PCF, refer to TS 29.507
{% if component.advanced_config and component.advanced_config.serviceList %}
{{ component.advanced_config.serviceList | to_nice_yaml(indent=4) | indent(4, True) }}
{% else %}
    - serviceName: npcf-am-policy-control # Npcf_AMPolicyControl service
    - serviceName: npcf-smpolicycontrol   # Npcf_SMPolicyControl service
      suppFeat: 3fff # the features supported by Npcf_SMPolicyControl, name defined in TS 29.512 5.8-1, value defined in TS 29.571 5.2.2
    - serviceName: npcf-bdtpolicycontrol    # Npcf_BDTPolicyControl service
    - serviceName: npcf-policyauthorization # Npcf_PolicyAuthorization service
      suppFeat: 3    # the features supported by Npcf_PolicyAuthorization, name defined in TS 29.514 5.8-1, value defined in TS 29.571 5.2.2
    - serviceName: npcf-eventexposure       # Npcf_EventExposure service
    - serviceName: npcf-ue-policy-control   # Npcf_UEPolicyControl service
    - serviceName: npcf-callback            # Npcf callback service
{% endif %}

  mongodb:       # the mongodb connected by this PCF
    name: {{ component.advanced_config.mongodb_name | default("free5gc", true) }}                      # name of the mongodb
    url: {{ component.advanced_config.mongodb_url | default("mongodb://test:test@free5gc-database/?authSource=admin", true) }}     # a valid URL of the mongodb

  locality: {{ component.advanced_config.locality | default("area1", true) }} # Name of the location where a set of AMF, SMF, PCF and UPFs are located

logger: # log output setting
{% if component.advanced_config and component.advanced_config.logger %}
{{ component.advanced_config.logger | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  enable: true # true or false
  level: debug # how detailed to output, value: trace, debug, info, warn, error, fatal, panic
  reportCaller: false # enable the caller report or not, value: true or false
{% endif %}

{% endif %}