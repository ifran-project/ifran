{% if component.plain_text_config -%}
{{ component.plain_text_config }}
{%- else %}
# SPDX-License-Identifier: LicenseRef-CSSL-1.0

# OAI CN Configuration File
### This file can be used by all OAI NFs
### Some fields are specific to an NF and will be ignored by other NFs

## NOTE ON YAML ANCHORS ##
# We use YAML anchors to ease the configuration and to avoid duplicating parts of the configuration.
# This is especially true for the SNSSAIs, as we have to define them for multiple NFs.
# Please note that the use of anchors is not mandatory, and you can define the SNSSAI in each NF yourself.
# You can read more about anchors here: https://yaml.org/spec/1.2.2/#anchors-and-aliases

############# Common configuration

# Log level for all the NFs
log_level:
{% if component.advanced_config and component.advanced_config.log_level %}
{{ component.advanced_config.log_level | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  general: debug
{% endif %}

# If you enable registration, the NF will use the NRF discovery mechanism
register_nf:
{% if component.advanced_config and component.advanced_config.register_nf %}
{{ component.advanced_config.register_nf | to_nice_yaml(indent=2) | indent(2, True) }}
{% else %}
  general: yes
{% endif %}

http_version: {{ component.advanced_config.http_version | default(2) }}  # allowed value 1 and 2, make sure all NFs use the same HTTP version

## general single_nssai configuration
## Defines YAML anchors, which are reused in the config file
snssais:
{% for slice in component.config.snssaiList %}
  - &{{ slice.name }}
    sst: {{ slice.sst }}
{% if slice.sd is not none %}
    sd: {{ slice.sd }}
{% endif %}
{% endfor %}

############## SBI Interfaces
### Each NF takes its local SBI interfaces and remote interfaces from here, unless it gets them using NRF discovery mechanisms
nfs:
  smf:
    host: {{ chart_name }}
    sbi:
      port: {{ component.config.sbi.port }}
      api_version: {{ component.config.sbi.apiVersion }}
      interface_name: {{ component.config.sbi.interfaceName }}
    n4:
      interface_name: {{ component.config.n4.interfaceName }}
      port: {{ component.config.n4.port }}
{% if component.advanced_config and component.advanced_config.nfs %}
{{ component.advanced_config.nfs | to_nice_yaml(indent=4) | indent(4, True) }}
{% endif %}

############## NF-specific configuration
smf:
  ue_mtu: {{ component.advanced_config.ue_mtu | default(1500) }}
  support_features:
{% if component.advanced_config and component.advanced_config.support_features %}
{{ component.advanced_config.support_features | to_nice_yaml(indent=4) | indent(4, True) }}
{% else %}
    use_local_subscription_info: yes # Use infos from local_subscription_info or from UDM
    use_local_pcc_rules: yes # Use infos from local_pcc_rules or from PCF
    discover_upf: yes
{% endif %}
  # we resolve from NRF, this is just to configure usage_reporting

{% if component.advanced_config and component.advanced_config.upfs %}
  upfs:
{{ component.advanced_config.upfs | to_nice_yaml(indent=4) | indent(4, True) }}
{% endif %}

{% if component.advanced_config and component.advanced_config.ue_dns %}
  ue_dns:
{{ component.advanced_config.ue_dns | to_nice_yaml(indent=4) | indent(4, True) }}
{% endif %}

{% if component.advanced_config and component.advanced_config.ims %}
  ims:
{{ component.advanced_config.ims | to_nice_yaml(indent=4) | indent(4, True) }}
{% endif %}
  # the DNN you configure here should be configured in "dnns"
  # follows the SmfInfo datatype from 3GPP TS 29.510
  smf_info:
    sNssaiSmfInfoList:
{% for slice in component.config.snssaiList %}
      - sNssai: *{{ slice.name }}
        dnnSmfInfoList:
{% for dnn in slice.dnns.values() %}
          - dnn: "{{ dnn.name }}"
{% endfor %}
{% endfor %}
  local_subscription_infos:
{% for slice in component.config.snssaiList %}
{% for dnn in slice.dnns.values() %}
{% for qos_flow in dnn.qosFlows %}
    - single_nssai: *{{ slice.name }}
      dnn: "{{ dnn.name }}"
      qos_profile:
        5qi: {{ qos_flow.fiveQI }}
        session_ambr_ul: "{{ dnn.aggregateMaximumBitRate.uplink }}"
        session_ambr_dl: "{{ dnn.aggregateMaximumBitRate.downlink }}"
{% endfor %}
{% endfor %}
{% endfor %}

## DNN configuration
dnns:
{% for slice in component.config.snssaiList %}
{% for dnn in slice.dnns.values() %}
  - dnn: "{{ dnn.name }}"
    pdu_session_type: "{{ dnn.pduSessionType | upper }}"
    ipv4_subnet: "{{ dnn.ipv4Network }}"
{% endfor %}
{% endfor %}

{% endif %}